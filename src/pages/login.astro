---
import HeadlessDayLayout from '@/layouts/HeadlessDayLayout.astro';
import HeroPills from '@/components/headless-day/HeroPills.astro';
import { HEADLESS_DAY_ROUTES } from '@/components/headless-day/routes';
import { resolveSessionMember } from '@/lib/server/submissions';
import { safeReturnTo } from '@/lib/server/requireMember';

// Custom member login: social sign-in only (Google / Facebook). Each button hands
// off to @wix/astro's built-in /api/auth/login with `idp`, which skips the Wix
// login page and goes straight to the provider. Login doubles as sign-up.
const returnToUrl = safeReturnTo(Astro.url.searchParams.get('returnToUrl'), HEADLESS_DAY_ROUTES.home);

// Already signed in — nothing to do here.
if (await resolveSessionMember()) return Astro.redirect(returnToUrl, 302);

const providerUrl = (idp: 'google' | 'facebook') =>
  `/api/auth/login?${new URLSearchParams({ idp, returnToUrl })}`;

// Same floating solution pills as the home hero, kept clear of the card.
const PILLS = [
  { label: 'Music', color: '#7b2ff7', top: 14, left: 14 },
  { label: 'Events', color: '#e5484d', top: 10, left: 50 },
  { label: 'Blog', color: '#e07b12', top: 18, left: 86 },
  { label: 'Ecommerce', color: '#1026ed', top: 50, left: 8 },
  { label: 'Education', color: '#1c1d21', top: 52, left: 92 },
  { label: 'Photo', color: '#12a5b5', top: 86, left: 18 },
  { label: 'Travel', color: '#e5399f', top: 84, left: 82 },
];
---

<HeadlessDayLayout title="Sign in | Headless Day" noindex bare>
  <main class="hcf-page hcf-login">
    <div class="hcf-hero-dots" aria-hidden="true"></div>
    <HeroPills pills={PILLS} />

    <section class="hcf-login-card" aria-labelledby="login-title">
      <p class="hcf-login-eyebrow">Headless Day</p>
      <h1 class="hcf-login-title" id="login-title">
        Create Without Boundaries.<br />Go Headless.
      </h1>
      <p class="hcf-login-sub">
        Sign in to build, submit your site, and like your favorites in the gallery.
      </p>

      <div class="hcf-login-actions">
        <a class="hcf-login-btn" href={providerUrl('google')}>
          <svg class="hcf-login-icon" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#FFC107"
              d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"
            ></path>
            <path
              fill="#FF3D00"
              d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
            ></path>
            <path
              fill="#4CAF50"
              d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"
            ></path>
            <path
              fill="#1976D2"
              d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"
            ></path>
          </svg>
          Continue with Google
        </a>
        <a class="hcf-login-btn" href={providerUrl('facebook')}>
          <svg class="hcf-login-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#1877F2"
              d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"
            ></path>
          </svg>
          Continue with Facebook
        </a>
      </div>

      <p class="hcf-login-fine">New here? Signing in creates your account automatically.</p>
    </section>
  </main>
</HeadlessDayLayout>
